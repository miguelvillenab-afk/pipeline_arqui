</mxCell><mxCell id="c663" value="PCCorrectE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C0392B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1900" y="77.5" width="77.375" height="17" as="geometry"/></mxCell><mxCell id="c664" value="Actualización BHT (PCE, PCSrcE, BranchE|JumpE de A y B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1500" y="103" width="332.812" height="16" as="geometry"/></mxCell><mxCell id="c665" value="PCPlus4E" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="2436.58" y="642.5" width="49.4219" height="15" as="geometry"/></mxCell><mxCell id="c666" value="PredTakenD" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C0392B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="47.5" width="81.7344" height="17" as="geometry"/></mxCell><mxCell id="c667" value="PredTargetD" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C0392B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="300" y="202.5" width="85.4531" height="17" as="geometry"/></mxCell><mxCell id="c668" value="pred_redirect (CLR)" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="634.414" y="244.914" width="95.1719" height="15" as="geometry"/></mxCell><mxCell id="c669" value="PCD0" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="744" y="342.5" width="32.3594" height="15" as="geometry"/></mxCell><mxCell id="c670" value="PCD1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="874" y="1372.5" width="32.3594" height="15" as="geometry"/></mxCell><mxCell id="c671" value="ImmExtD0" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1448" y="1002.5" width="55.3906" height="15" as="geometry"/></mxCell><mxCell id="c672" value="ImmExtD1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1384" y="1552.5" width="55.3906" height="15" as="geometry"/></mxCell><mxCell id="c673" value="PredictD0" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="643.5" width="51.6562" height="15" as="geometry"/></mxCell><mxCell id="c674" value="PredictD1" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1395" y="1848.5" width="51.6562" height="15" as="geometry"/></mxCell><mxCell id="c675" value="PredictE0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1526" y="643" width="62.1094" height="16" as="geometry"/></mxCell><mxCell id="c676" value="PredictE1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1526" y="1848" width="62.1094" height="16" as="geometry"/></mxCell><mxCell id="c677" value="PredictE0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2275.44" y="2316.44" width="55.125" height="16" as="geometry"/></mxCell><mxCell id="c678" value="PredictE1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2290.44" y="2316.44" width="55.125" height="16" as="geometry"/></mxCell><mxCell id="c679" value="Arquitectura C: Dual-Issue con predictor dinámico de 2 bits — datapath según sources/datapath_opt.v (rama opti). En rojo, lo que se agrega al Dual-Issue (B)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2501" width="1079.28" height="18" as="geometry"/></mxCell><mxCell id="c680" value="BHT (bht_opt): 64 contadores de 2 bits, inicio 01 (débil no tomado), predice tomado si el bit alto es 1. Se lee en ID con PCD0/PCD1 y se actualiza en EX con el resultado real (PCSrcE)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2523" width="1103.91" height="18" as="geometry"/></mxCell><mxCell id="c681" value="No hay BTB: el destino se calcula en ID (PCD + ImmExtD). Un salto tomado bien predicho cuesta 1 ciclo (pred_redirect limpia IF/ID); un fallo cuesta 2 (flush de IF/ID e ID/EX)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2545" width="1048.88" height="18" as="geometry"/></mxCell><mxCell id="c682" value="Mispredict_x = (BranchE_x | JumpE_x) · (PCSrcE_x ≠ PredictE_x). Prioridad del PC: mispredict (PC correcto) &gt; predicción (destino de ID) &gt; secuencial (+8 / +4 según IssueB)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2567" width="1048.66" height="18" as="geometry"/></mxCell><mxCell id="c683" value="Saltos: PCSrcE_x = (BranchE_x · ZeroE_x) | JumpE_x — solo beq y jal (la base de opti no tiene blt). Mux de forwarding (mux5): 000 ID/EX, 001 ResultW0, 010 ResultW1, 011 ALUResultM0, 100 ALUResultM1." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2589" width="1239.02" height="18" as="geometry"/></mxCell><mxCell id="c684" value="Hazard Unit (hazard_opt): forwarding y load-use iguales a B; el flush por salto se activa solo con mispredict. flush_idex_b = FlushE1 | ~IssueBD; flush_exmem_b fijo en 0." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2611" width="1027.03" height="18" as="geometry"/></mxCell><mxCell id="c685" value="No se dibujan por claridad: lógica es_salto (opcode) y AND con IssueBD dentro del predictor, ID_EX_PCTarget (sin uso) y el selector de PC+4 de la vía B dentro de Recuperación." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2633" width="1068.64" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>