ell><mxCell id="c630" value="RegWriteM1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2530.8" y="1989.8" width="68.3906" height="16" as="geometry"/></mxCell><mxCell id="c631" value="RdM1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2560.86" y="2005.86" width="36.2812" height="16" as="geometry"/></mxCell><mxCell id="c632" value="RdM0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2574.86" y="2005.86" width="36.2812" height="16" as="geometry"/></mxCell><mxCell id="c633" value="RegWriteM0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2572.8" y="1989.8" width="68.3906" height="16" as="geometry"/></mxCell><mxCell id="c634" value="RegWriteW1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3210.17" y="1989.17" width="69.6562" height="16" as="geometry"/></mxCell><mxCell id="c635" value="RdW1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3240.23" y="2005.23" width="37.5469" height="16" as="geometry"/></mxCell><mxCell id="c636" value="RdW0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3254.23" y="2005.23" width="37.5469" height="16" as="geometry"/></mxCell><mxCell id="c637" value="RegWriteW0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3252.17" y="1989.17" width="69.6562" height="16" as="geometry"/></mxCell><mxCell id="c638" value="Procesador RISC-V Dual-Issue — datapath según src_super/datapath_dual.v (rama fase2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2181" width="608.656" height="18" as="geometry"/></mxCell><mxCell id="c639" value="Vía 0 = vía A (instrucción más antigua, sufijo _A en el Verilog); Vía 1 = vía B (sufijo _B)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2203" width="532.438" height="18" as="geometry"/></mxCell><mxCell id="c640" value="Mux de forwarding (mux5): 000 = valor de ID/EX, 001 = ResultW0, 010 = ResultW1, 011 = ALUResultM0, 100 = ALUResultM1. Mux A → SrcA, mux B → SrcB (después del mux ALUSrc), mux C → dato de store." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2225" width="1253.45" height="18" as="geometry"/></mxCell><mxCell id="c641" value="PCSrcE_x = (BranchE_x · ZeroE_x) | JumpE_x. Cada vía tiene su propio sumador de target (PCE + ImmExtE). Prioridad del PC: PCSrcE0 &gt; PCSrcE1 &gt; IssueB (+8 / +4)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2247" width="1001.95" height="18" as="geometry"/></mxCell><mxCell id="c642" value="LUI → x0: si el opcode es LUI, rs1 se fuerza a x0. Register File con bypass de escritura (la vía 1 tiene prioridad si ambas escriben el mismo registro)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2269" width="895.375" height="18" as="geometry"/></mxCell><mxCell id="c643" value="flush_idex_b = FlushE1 | ~IssueBD. No se dibujan: Zero, PCTarget, Branch y Jump guardados en EX/MEM (sin uso), ImmSrc en ID/EX (sin uso) y flush_exmem_b (fijo en 0)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="195" y="2291" width="1029.05" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>