l=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1387.59" y="1387.59" width="32.8281" height="16" as="geometry"/></mxCell><mxCell id="c308" value="ALUSrcE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1392.36" y="1379.36" width="49.2812" height="16" as="geometry"/></mxCell><mxCell id="c309" value="ResultSrcE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1399.52" y="1373.52" width="60.9531" height="16" as="geometry"/></mxCell><mxCell id="c310" value="RegWriteE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1433.14" y="1374.14" width="59.7188" height="16" as="geometry"/></mxCell><mxCell id="c311" value="ForwardAE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1707.32" y="1373.32" width="61.3594" height="16" as="geometry"/></mxCell><mxCell id="c312" value="ForwardBE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1674.31" y="1373.31" width="61.375" height="16" as="geometry"/></mxCell><mxCell id="c313" value="ForwardCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1650.25" y="1373.25" width="61.5" height="16" as="geometry"/></mxCell><mxCell id="c314" value="PCSrcE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2146.47" y="1382.47" width="43.0625" height="16" as="geometry"/></mxCell><mxCell id="c315" value="RdM" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2278.04" y="1389.04" width="29.9219" height="16" as="geometry"/></mxCell><mxCell id="c316" value="RegWriteM" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2281.98" y="1372.98" width="62.0312" height="16" as="geometry"/></mxCell><mxCell id="c317" value="RdW" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2737.41" y="1388.41" width="31.1875" height="16" as="geometry"/></mxCell><mxCell id="c318" value="RegWriteW" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3355DD;fontStyle=0;spacing=0;rotation=-90;" vertex="1" parent="1"><mxGeometry x="2741.35" y="1372.35" width="63.2969" height="16" as="geometry"/></mxCell><mxCell id="c319" value="Procesador RISC-V Pipeline Single-Issue — datapath según src files/datapath_pipeline.v (rama Hazard)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1551" width="702.703" height="18" as="geometry"/></mxCell><mxCell id="c320" value="Forwarding (mux3): 00 = valor de ID/EX, 01 = ResultW, 10 = ALUResultM (prioridad a MEM). ForwardA → SrcA, ForwardB → SrcB (después del mux ALUSrc), ForwardC → dato de sw y operando B del comparador." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1573" width="1272.11" height="18" as="geometry"/></mxCell><mxCell id="c321" value="Branch Comparator según funct3: beq, bne, blt, bge, bltu, bgeu. PCSrcE = (BranchE · BranchTakenE) | JumpE. jal: PCE + ImmExtE; jalr (JumpRegE = 1): {ALUResultE[31:1], 0}." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1595" width="1060.16" height="18" as="geometry"/></mxCell><mxCell id="c322" value="Load-use: StallF = StallD = 1 y FlushE = 1 (burbuja). Salto tomado: FlushD = FlushE = 1. LUI → x0: si el opcode es LUI, rs1 se fuerza a x0." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1617" width="836.625" height="18" as="geometry"/></mxCell><mxCell id="c323" value="Register File: x0 no se escribe y lectura con bypass si WB escribe el mismo registro. ALUControl de 4 bits: add, sub, and, or, xor, slt, sltu, sll, srl, sra." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1639" width="898.891" height="18" as="geometry"/></mxCell><mxCell id="c324" value="No se dibujan: Zero, PCTarget, Branch y Jump guardados en EX/MEM (sin uso), ImmSrc en ID/EX (sin uso) y la entrada de stall de ID/EX (fija en 0)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1661" width="883.312" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>