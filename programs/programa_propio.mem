60000093  // 000: addi x1, x0, 1536          x1 = 1536: dirección base del arreglo
00700113  // 004: addi x2, x0, 7             x2 = 7
0020a023  // 008: sw   x2, 0(x1)             arreglo[0] = 7    (dirección 1536)
ffd00193  // 00c: addi x3, x0, -3            x3 = -3
0030a223  // 010: sw   x3, 4(x1)             arreglo[1] = -3   (1540)
00c00213  // 014: addi x4, x0, 12            x4 = 12
0040a423  // 018: sw   x4, 8(x1)             arreglo[2] = 12   (1544)
0020a623  // 01c: sw   x2, 12(x1)            arreglo[3] = 7    (1548), reutiliza x2
0000a823  // 020: sw   x0, 16(x1)            arreglo[4] = 0    (1552), x0 siempre vale 0
01900293  // 024: addi x5, x0, 25            x5 = 25
0050aa23  // 028: sw   x5, 20(x1)            arreglo[5] = 25   (1556)
0020ac23  // 02c: sw   x2, 24(x1)            arreglo[6] = 7    (1560)
ff800313  // 030: addi x6, x0, -8            x6 = -8
0060ae23  // 034: sw   x6, 28(x1)            arreglo[7] = -8   (1564)
00000593  // 038: addi x11, x0, 0            suma = 0
00700793  // 03c: addi x15, x0, 7            x15 = 7: la "clave" que vamos a contar
00000b13  // 040: addi x22, x0, 0            contador de elementos que NO son 7 = 0
02008913  // 044: addi x18, x1, 32           x18 = 1568: dirección justo después del arreglo
0000a603  // 048: lw   x12, 0(x1)            máximo = arreglo[0] (primer valor como inicio)
00400c93  // 04c: addi x25, x0, 4            pasadas que faltan = 4
000088b3  // 050: pasada: add  x17, x1, x0   puntero = inicio del arreglo (1536)
0008aa03  // 054: recorrido: lw   x20, 0(x17) x20 = elemento actual
014585b3  // 058: add  x11, x11, x20         suma = suma + elemento
00ca4463  // 05c: blt  x20, x12, no_max      SALTO: si elemento < máximo, no cambia el máximo
000a0633  // 060: add  x12, x20, x0          si no saltó: máximo = elemento
00fa0463  // 064: no_max: beq  x20, x15, es_clave SALTO: si elemento == 7, se salta la línea siguiente
001b0b13  // 068: addi x22, x22, 1           (solo si NO es 7) contador de "no es 7" + 1
00488893  // 06c: es_clave: addi x17, x17, 4 puntero avanza al siguiente elemento
ff28c2e3  // 070: blt  x17, x18, recorrido   SALTO: si quedan elementos, vuelve a leer
fffc8c93  // 074: addi x25, x25, -1          una pasada menos
fd904ce3  // 078: blt  x0, x25, pasada       SALTO: si quedan pasadas (0 < x25), repite
02000693  // 07c: addi x13, x0, 32           32 elementos revisados en total (8 x 4)
416686b3  // 080: sub  x13, x13, x22         veces el 7 = 32 - (los que no eran 7) = 12
02b0a023  // 084: sw   x11, 32(x1)           1568: suma = 188
02c0a223  // 088: sw   x12, 36(x1)           1572: máximo = 25
02d0a423  // 08c: sw   x13, 40(x1)           1576: veces el 7 = 12
00c5cc33  // 090: xor  x24, x11, x12         x24 = suma xor máximo = 165 (dato de control)
0380a623  // 094: sw   x24, 44(x1)           1580: control = 165 (último sw: fin de la medición)
0000006f  // 098: fin: jal  x0, fin          bucle infinito (no se cuenta en las mediciones)
