00500093  // 00: addi x1, x0, 5          x1 = 5
ffd00113  // 04: addi x2, x0, -3         x2 = -3
1230a1b7  // 08: lui  x3, 0x1230A        x3 = 0x1230A000 (bits 19:15 apuntan a x1: prueba lui con rs1 forzado a x0)
00208233  // 0c: add  x4, x1, x2         x4 = 2      (x2 por forwarding desde MEM)
404102b3  // 10: sub  x5, x2, x4         x5 = -5     (x4 por forwarding desde MEM, consecutiva)
0020c333  // 14: xor  x6, x1, x2         x6 = 5 ^ -3
005376b3  // 18: and  x13, x6, x5        x13 = x6 & x5 (x6 consecutiva, x5 desde WB)
001093b3  // 1c: sll  x7, x1, x1         x7 = 160
00115433  // 20: srl  x8, x2, x1         x8 = 0x07FFFFFF
401154b3  // 24: sra  x9, x2, x1         x9 = -1
00112533  // 28: slt  x10, x2, x1        x10 = 1
001135b3  // 2c: sltu x11, x2, x1        x11 = 0
0072e633  // 30: or   x12, x5, x7        x12 = -5 | 160
7ff14713  // 34: xori x14, x2, 0x7FF     x14 = -3 ^ 0x7FF
00311793  // 38: slli x15, x2, 3         x15 = -24
01c15813  // 3c: srli x16, x2, 28        x16 = 0xF
40115893  // 40: srai x17, x2, 1         x17 = -2
ffe12913  // 44: slti x18, x2, -2        x18 = 1
fff0b993  // 48: sltiu x19, x1, -1       x19 = 1
0f017a13  // 4c: andi x20, x2, 0xF0      x20 = 0xF0
1000ea93  // 50: ori  x21, x1, 0x100     x21 = 0x105
00700013  // 54: addi x0, x0, 7          x0 debe seguir en 0
00100b33  // 58: add  x22, x0, x1        x22 = 5 (no debe haber forwarding desde x0)
01608663  // 5c: beq  x1, x22, L1        tomado (x22 por forwarding desde MEM)
001f8f93  // 60: addi x31, x31, 1        no debe ejecutarse
001f8f93  // 64: addi x31, x31, 1        no debe ejecutarse
01621463  // 68: bne  x4, x22, L2        tomado
001f8f93  // 6c: addi x31, x31, 1      
00114463  // 70: blt  x2, x1, L3         tomado (-3 < 5)
001f8f93  // 74: addi x31, x31, 1      
08115063  // 78: bge  x2, x1, BAD        no tomado
06116e63  // 7c: bltu x2, x1, BAD        no tomado (0xFFFFFFFD > 5 sin signo)
00117463  // 80: bgeu x2, x1, L4         tomado
001f8f93  // 84: addi x31, x31, 1      
06208863  // 88: beq  x1, x2, BAD        no tomado
07609663  // 8c: bne  x1, x22, BAD       no tomado
0020e463  // 90: bltu x1, x2, L5         tomado
001f8f93  // 94: addi x31, x31, 1      
00000b93  // 98: addi x23, x0, 0         suma = 0
00400c13  // 9c: addi x24, x0, 4         i = 4
018b8bb3  // a0: add  x23, x23, x24      suma += i
fffc0c13  // a4: addi x24, x24, -1       i--
fe0c1ce3  // a8: bne  x24, x0, LOOP      salto hacia atrás, x24 por forwarding
01702423  // ac: sw   x23, 8(x0)         mem[8] = 10
00802c83  // b0: lw   x25, 8(x0)         x25 = 10
017c8463  // b4: beq  x25, x23, L6       load-use (stall) y salto tomado
001f8f93  // b8: addi x31, x31, 1      
001c8d13  // bc: addi x26, x25, 1        x26 = 11
01a02623  // c0: sw   x26, 12(x0)        dato del sw por forwarding (consecutiva)
00002d83  // c4: lw   x27, 0(x0)         x27 = 10 (valor inicial de dmem)
01bd8db3  // c8: add  x27, x27, x27      load-use: x27 = 20
020000ef  // cc: jal  x1, F2             llamada: x1 = dirección de retorno
02000e6f  // d0: jal  x28, FUNC          llamada: x28 = dirección de retorno
0e400e93  // d4: addi x29, x0, T         x29 = dirección de T
001e8f67  // d8: jalr x30, 1(x29)        salta a (x29 + 1) & ~1 = T; x30 = retorno
001f8f93  // dc: addi x31, x31, 1      
001f8f93  // e0: addi x31, x31, 1      
01e02823  // e4: sw   x30, 16(x0)        mem[16] = dirección guardada por jalr
00000063  // e8: beq  x0, x0, END        fin
00008067  // ec: jalr x0, 0(x1)          retorna de inmediato (x1 recién escrito por jal)
001a8a93  // f0: addi x21, x21, 1        x21 = 0x106
000e0067  // f4: jalr x0, 0(x28)         retorna
064f8f93  // f8: addi x31, x31, 100    
fe0006e3  // fc: beq  x0, x0, END      
